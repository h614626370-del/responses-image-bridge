# Copy to .env and change as necessary. No real keys belong in this file.
HOST=127.0.0.1
PORT=8787
UPSTREAM_BASE_URL=https://kkflow.org
CONTROL_MODEL=gpt-5.6-luna
# Base64 and public HTTPS image-to-image requests use /v1/images/edits directly by default.
DIRECT_EDITS=true

# Generation always forwards the client's Bearer key; no fixed server key.

# Heartbeats also run while requests are queued.
HEARTBEAT_MS=5000
# Empty: no local concurrency limit; sub2api enforces user/account limits.
MAX_CONCURRENT=
MAX_QUEUE=60
# Total budget includes queueing, upstream and client delivery.
REQUEST_TIMEOUT_MS=900000
MAX_BODY_BYTES=33554432
MAX_RESPONSE_BYTES=67108864

# Compatibility switch: append data: [DONE] after the terminal event.
SSE_DONE_SENTINEL=false
# DANGER: stores Authorization, prompts, image URLs and Base64 bodies exactly as received.
RAW_REQUEST_LOGGING=false

# Local settings, encrypted keys and request metadata; keep this directory private.
DATA_DIR=data
# Empty: create data/admin-token.txt automatically. Otherwise minimum 24 characters.
MANAGEMENT_KEY=
# Enable when the management UI is served over HTTPS.
COOKIE_SECURE=false
